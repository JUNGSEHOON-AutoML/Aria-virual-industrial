{
  "schema_version": 1,
  "status": "G1_registry_enforced",
  "default_action": "deny",
  "policy": {
    "registration_required_for": "all_motion",
    "allow_unregistered": false,
    "ambient_may_feed_information_panels": false,
    "require_source": true,
    "require_clock": true,
    "event_only_entities": [
      "part",
      "box",
      "pallet",
      "truck",
      "forklift",
      "worker",
      "patrol_robot",
      "robot_arm"
    ]
  },
  "motions": [
    {
      "id": "replay.parts",
      "kind": "event",
      "source": "api:/api/dt/runs/{id}/timeline#parts",
      "clock": "sim",
      "enabled": true,
      "status": "connected_G1"
    },
    {
      "id": "replay.reinspection_queue",
      "kind": "event",
      "source": "api:/api/dt/runs/{id}/timeline#queue",
      "clock": "sim",
      "enabled": true,
      "status": "connected_G1"
    },
    {
      "id": "view.camera",
      "kind": "event",
      "source": "ui:camera_input_or_site_selection",
      "clock": "view_transition",
      "enabled": true,
      "status": "connected_G1"
    },
    {
      "id": "view.roof_fade",
      "kind": "event",
      "source": "ui:site_selection",
      "clock": "view_transition",
      "enabled": true,
      "status": "connected_G1"
    },
    {
      "id": "logistics.actors",
      "kind": "event",
      "source": "api:/api/dt/runs/{id}/logistics",
      "clock": "sim",
      "enabled": true,
      "status": "connected_G2"
    },
    {
      "id": "live.parts",
      "kind": "event",
      "source": "ws:/api/live/ws#parts",
      "clock": "live_des",
      "enabled": true,
      "status": "connected_L2"
    },
    {
      "id": "live.robot",
      "kind": "event",
      "source": "ws:/api/live/ws#metrics.resources.AI-INSPECTION.robot",
      "clock": "live_des",
      "enabled": false,
      "status": "INVALID_inspection_arm_visualization_replaced_by_TRANSFER"
    },
    {
      "id": "live.patrol",
      "kind": "event",
      "source": "ws:/api/live/ws#patrol.robots",
      "clock": "live_des",
      "enabled": true,
      "status": "connected_L2"
    },
    {
      "id": "live.maintenance",
      "kind": "event",
      "source": "ws:/api/live/ws#patrol.maintenance",
      "clock": "live_des",
      "enabled": true,
      "status": "connected_L2"
    },
    {
      "id": "stations.equipment",
      "kind": "event",
      "source": "api:/api/dt/runs/{id}/stations#equipment,parts",
      "clock": "sim",
      "enabled": true,
      "status": "connected_S1_S2"
    },
    {
      "id": "stations.transfer",
      "kind": "event",
      "source": "api:/api/dt/runs/{id}/stations#transfer_tasks",
      "clock": "sim",
      "enabled": true,
      "status": "connected_S3"
    },
    {
      "id": "stations.live_equipment",
      "kind": "event",
      "source": "ws:/api/live/ws#station",
      "clock": "live_des",
      "enabled": true,
      "status": "connected_S1_S3"
    },
    {
      "id": "stations.live_transfer",
      "kind": "event",
      "source": "ws:/api/live/ws#station",
      "clock": "live_des",
      "enabled": true,
      "status": "connected_S1_S3"
    },
    {
      "id": "stations.products",
      "kind": "event",
      "source": "api:/api/dt/runs/{id}/stations#parts,products,transfer_tasks",
      "clock": "sim",
      "enabled": true,
      "status": "connected_S2_S3"
    }
  ],
  "ambient": [],
  "invalid_legacy_motion": [
    {
      "path": "frontend/src/campus/Replay.jsx",
      "symbol": "CampusRollers",
      "reason": "Clock-only rotation must be connected to equipment events or disabled in G1."
    },
    {
      "path": "frontend/src/cnotta/Motion.jsx",
      "symbol": "ProcessMotion robotYaw",
      "reason": "Synthetic robot yaw is not a recorded robot action; connect L2 robot events or disable."
    }
  ]
}
