# Choose explicitly. memory is volatile development, never a PostgreSQL fallback.
ARIA_HISTORY_BACKEND=memory
# PostgreSQL deployment: configure DSN in private environment; never commit secrets.
# ARIA_HISTORY_BACKEND=postgres
# ARIA_HISTORY_DSN=host=127.0.0.1 port=55432 dbname=aria user=aria password=...
# ARIA_HISTORY_SPOOL=/persistent-volume/aria-history-spool
# Demonstration defaults; size against observed event rate and outage tolerance.
ARIA_HISTORY_QUEUE_SIZE=4096
ARIA_HISTORY_SPOOL_BYTES=67108864
ARIA_HISTORY_RETRY_MIN=0.2
ARIA_HISTORY_RETRY_MAX=5
ARIA_HISTORY_MAX_LAG=300
ARIA_HISTORY_BATCH_SIZE=64
ARIA_HISTORY_SHUTDOWN_TIMEOUT=8
